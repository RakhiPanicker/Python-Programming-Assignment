# 1. Create a list names age_list with five interger elements

age_list = [24,25,26,27,28]
print(age_list)

# 2. Create a list names name_list with five string elements

name_list = ["Meera","Ravi","Anu","Amal","Jack"]
print(name_list)

# List Operations / Modifications
# a. Append the string "Yazhini" to name_list.
name_list.append("Yazhini")
print(name_list)

# b. Insert the element 30 at index 2 in age_list.
age_list.insert(2,30)
print(age_list)     # in place of 26, 30 got inserted

# c.Remove the string "Yazhini" from name_list.
name_list.remove("Yazhini")
print(name_list)      # "Yazhini" is removed from the name list

# d. Pop the last element from age_list
age_list.pop()
print(age_list)     # pop() will remove the last element from the list

# e. Extend the age_list with additional ages [29, 30, 26]
age_list.extend([29,30,26])
print(age_list)        # To add multiple values in the given list we use extend

# f. Sort age_list in descending order
age_list.sort(reverse=True)
print(age_list)     # It will reverse the complete number list in desc order

# g. Find Max age, Min age and sum of all ages from age_list.

max(age_list)
print("Maximum age:", max(age_list))

min(age_list)
print("Minimum age:", min(age_list))

sum(age_list)
print("Sum age:", sum(age_list))

